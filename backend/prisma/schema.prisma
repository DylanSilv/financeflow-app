generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USER ────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  // Nullable en la base: los usuarios que entran por Supabase Auth no guardan
  // contraseña en esta tabla.
  password      String?
  name          String
  // Enlace con auth.users de Supabase. current_app_user_id() resuelve el usuario
  // de la app con `WHERE auth_id = auth.uid()`, y TODOS los RPC dependen de esa
  // función: si esta columna desaparece, la app entera deja de autenticar.
  auth_id       String?        @unique @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts        Account[]
  loans           Loan[]
  transfers       Transfer[]
  transactions    Transaction[]
  categories      Category[]
  cards           Card[]
  fixedExpenses   FixedExpense[]
  savingsGoals    SavingsGoal[]
  monthlyHistory  MonthlyHistory[]
}

// ─── ACCOUNT ─────────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  color          String?
  initialBalance Decimal     @default(0) @db.Decimal(10, 2)
  isArchived     Boolean     @default(false)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  cards         Card[]
  fixedExpenses FixedExpense[]
  transfersFrom Transfer[]    @relation("TransferFrom")
  transfersTo   Transfer[]    @relation("TransferTo")

  @@unique([name, userId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  BENEFIT
}

// ─── TRANSFER ────────────────────────────────────────────────

model Transfer {
  id            String   @id @default(uuid())
  amount        Decimal  @db.Decimal(10, 2)
  date          DateTime
  description   String?
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

// ─── LOAN ────────────────────────────────────────────────────

model Loan {
  id                String     @id @default(uuid())
  name              String
  loanType          LoanType
  originalAmount    Decimal    @db.Decimal(10, 2)
  totalInstallments Int
  installmentAmount Decimal    @db.Decimal(10, 2)
  paidInstallments  Int        @default(0)
  // Saldo que mantiene pay_loan_installment aplicando interestRate. Queda nulo
  // en los préstamos creados antes de esa función.
  currentBalance    Decimal?   @db.Decimal(14, 2)
  // Tasa nominal anual en %. La calcula el frontend a partir de capital, cuota
  // y plazo (ver frontend/src/lib/loanMath.ts). Null = compra en cuotas sin
  // interés, y en ese caso originalAmount es el total a pagar, no el capital.
  interestRate      Decimal?   @db.Decimal(9, 4)
  startDate         DateTime?
  endDate           DateTime?
  status            LoanStatus @default(ACTIVE)
  notes             String?    @db.Text
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  fixedExpense FixedExpense?
}

enum LoanType {
  PERSONAL
  PURCHASE
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

// ─── CATEGORY ────────────────────────────────────────────────

model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  color        String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([name, userId])
}

// ─── CARD ────────────────────────────────────────────────────

model Card {
  id             String   @id @default(uuid())
  name           String
  type           CardType
  limit          Decimal? @db.Decimal(10, 2)
  balanceUsed    Decimal  @default(0) @db.Decimal(10, 2)
  brand          String?
  lastFourDigits String?
  color          String?
  statementDay   Int?
  dueDay         Int?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactions Transaction[]
}

enum CardType {
  CREDIT
  DEBIT
}

// ─── TRANSACTION ─────────────────────────────────────────────

model Transaction {
  id            String          @id @default(uuid())
  title         String
  description   String?
  amount        Decimal         @db.Decimal(10, 2)
  ivaAmount     Decimal?        @db.Decimal(12, 2)
  date          DateTime
  type          TransactionType
  paymentMethod PaymentMethod

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  cardId String?
  card   Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: SetNull)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
}

// ─── FIXED EXPENSE ───────────────────────────────────────────

model FixedExpense {
  id      String        @id @default(uuid())
  name       String
  amount     Decimal       @db.Decimal(10, 2)
  dueDate    Int
  autoPay    Boolean       @default(false)
  status     ExpenseStatus @default(PENDING)
  lastPaidAt DateTime?
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  loanId String? @unique
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: SetNull)
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

// ─── MONTHLY HISTORY ─────────────────────────────────────────

model MonthlyHistory {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  year     Int
  month    Int
  income   Decimal @db.Decimal(10, 2)
  expenses Decimal @db.Decimal(10, 2)
  label    String

  @@unique([userId, year, month])
  @@index([userId])
}

// ─── SAVINGS GOAL ────────────────────────────────────────────

model SavingsGoal {
  id            String    @id @default(uuid())
  name          String
  targetAmount  Decimal   @db.Decimal(10, 2)
  currentAmount Decimal   @default(0) @db.Decimal(10, 2)
  deadline      DateTime?
  color         String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
