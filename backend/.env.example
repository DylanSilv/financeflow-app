# ─── Supabase / PostgreSQL ────────────────────────────────────
# URL de conexión pooled (pgBouncer) — para la app en runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# URL de conexión directa — solo para prisma migrate
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-32-chars"

# ─── Servidor ─────────────────────────────────────────────────
PORT=4000

# ─── CORS ─────────────────────────────────────────────────────
# Origen del frontend (separados por coma si hay varios)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
